# Copier en .env (docker compose le lit automatiquement). Toutes les valeurs ont un défaut.
# Doit être IDENTIQUE au jwtSecret du release Helm central.
JWT_SECRET=airflow-edge-demo-jwt-secret-please-change-0123456789
# Suffixe du hostname du worker (laptop-<USERNAME>) ; sous Windows, USERNAME est déjà défini.
USERNAME=dev
# Route vers l'api-server : ingress Traefik (défaut) ou repli port-forward :
#   kubectl port-forward -n airflow-edge svc/airflow-api-server 8080:8080 --address 0.0.0.0
#   EDGE_API_URL=http://host.docker.internal:8080/edge_worker/v1/rpcapi
EDGE_API_URL=http://airflow-edge.localhost/edge_worker/v1/rpcapi
# Endpoint S3 vu depuis le laptop (la connexion minio_s3 porte l'endpoint interne au cluster).
MINIO_ENDPOINT_URL=http://minio.localhost
