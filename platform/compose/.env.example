# Copier en .env (docker compose le lit automatiquement). Toutes les valeurs ont un défaut = le contrat (PLAN.md).
# Image centrale (construite par `docker compose build` ou `uv run scripts/build.py --central`).
AIRFLOW_IMAGE_NAME=airflow-edge/airflow-central:3.3.2
# UID des fichiers créés dans les volumes ; 50000 = utilisateur airflow de l'image officielle.
AIRFLOW_UID=50000
# Secrets FIXES (démo). JWT_SECRET doit être IDENTIQUE sur tous les workers (AIRFLOW__API_AUTH__JWT_SECRET).
JWT_SECRET=airflow-edge-demo-jwt-secret-please-change-0123456789
FERNET_KEY=YWlyZmxvdy1lZGdlLWRlbW8tZmVybmV0LWtleS0zMmI=
API_SECRET_KEY=airflow-edge-demo-api-secret-key
# URL publique de l'UI (liens dans les mails / l'UI).
AIRFLOW_BASE_URL=http://localhost:8080
# Compte administrateur créé par airflow-init.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
